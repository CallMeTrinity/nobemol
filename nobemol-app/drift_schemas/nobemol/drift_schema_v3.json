    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"lesson_id\" TEXT NULL, \"arcade\" TEXT NULL, \"score\" INTEGER NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NOT NULL, \"questions\" INTEGER NOT NULL, \"correct\" INTEGER NOT NULL, \"xp\" INTEGER NOT NULL, \"best_combo\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "answers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"answers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"expected\" TEXT NOT NULL, \"given\" TEXT NOT NULL, \"elapsed_ms\" INTEGER NOT NULL, \"xp\" INTEGER NOT NULL, \"card\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "theory",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"theory\" (\"lesson_id\" TEXT NOT NULL, \"page\" INTEGER NOT NULL, \"read\" INTEGER NOT NULL CHECK (\"read\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"lesson_id\"));"
        }
      ]
    },
    {
      "name": "mastered_skills",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mastered_skills\" (\"skill_id\" TEXT NOT NULL, \"mastered_at\" TEXT NOT NULL, PRIMARY KEY (\"skill_id\"));"
        }
      ]
    }
